{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.agents/AGENT.md"],
  "model": "enmaas/rits/zai-org/glm-5-3",
  "update": "disable",
  "providers": {
    "enmaas": {
      "name": "EnMaaS",
      "env": ["ENMAAS_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.enmaas.devshift.net/v1"
      },
      "models": {
        "rits/zai-org/glm-5-3": {
          "name": "GLM 5.3",
          "limit": { "context": 1048576, "output": 65536 }
        },
        "rits/deepseek-ai/DeepSeek-V4.1-Flash-1017": {
          "name": "DeepSeek V4.1 Flash"
        }
      }
    },
    "openai": {
      "env": ["ENMAAS_KEY"],
      "settings": { "baseURL": "https://api.enmaas.devshift.net/v1" }
    },
    "anthropic": {
      "env": ["ENMAAS_KEY"],
      "settings": { "baseURL": "https://api.enmaas.devshift.net/v1" },
      "models": {
        "claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5 (EnMaaS)",
          "compatibility": { "supportsThinkingBlockBinding": false }
        },
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5 (EnMaaS)",
          "compatibility": { "supportsThinkingBlockBinding": false }
        }
      }
    }
  },
  "mcp": {
    "konflux": {
      "enabled": false,
      "type": "local",
      "command": [
        "podman",
        "run",
        "-i",
        "--rm",
        "--network=host",
        "quay.io/eisraeli/konflux-portal-mcp"
      ]
    },
    "chaibot_konflux_public": {
      "enabled": false,
      "type": "remote",
      "url": "{env:CHAIBOT_MCP_URL}",
      "headers": {
        "Authorization": "Bearer {env:CHAIBOT_MCP_TOKEN}"
      }
    }
  }
}
